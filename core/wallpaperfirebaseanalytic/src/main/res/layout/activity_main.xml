<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity"
        android:orientation="vertical"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/btnEvenFace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Facebook" />

            <Button
                android:id="@+id/btnEvenIns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instagram" />

            <Button
                android:id="@+id/btnEvenTiktok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiktok" />

            <Button
                android:id="@+id/btnEvenYT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Youtube" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/btnUserFoodBanana"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Banana" />

            <Button
                android:id="@+id/btnUserFoodApple"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apple" />

            <Button
                android:id="@+id/btnUserFoodMango"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mango" />

            <Button
                android:id="@+id/btnUserFoodTomato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tomato" />
        </LinearLayout>

        <com.google.android.gms.ads.AdView
            android:id="@+id/bannerAd"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/black"
            app:adSize="BANNER"
            app:adUnitId="ca-app-pub-9146113363422654/6008769526"
            />

    </LinearLayout>
</layout>